# La hoja compartida permite lectura por exportación; no se cambian sus permisos.
GOOGLE_SHEET_ID=1vSevS3HEHGnGEc4q3Gjd4874iQJqySkN1hnWFVKssaU
SOURCE_MODE=public
REFRESH_SECONDS=60

# Para una hoja privada: SOURCE_MODE=google y uno de los métodos siguientes.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Solo para pruebas o uso local explícito: SOURCE_MODE=file.
LOCAL_WORKBOOK=

# Copiloto opcional. Configure un modelo habilitado para su cuenta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
